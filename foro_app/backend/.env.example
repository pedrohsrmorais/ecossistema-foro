# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3040
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# URL usada para montar o link de redefinição de senha enviado por e-mail
# (/reset-password?token=...). Em produção, aponte para o domínio público.

# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=foro_db
DB_USER=foro_user
DB_PASSWORD=foro_secret
DB_ROOT_PASSWORD=root_secret
DB_CONNECTION_LIMIT=10

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d

# ─── Resend (envio de e-mail: verificação de cadastro + reset de senha) ──────
# Sem RESEND_API_KEY, o backend só loga o código/link no console (modo dev).
# 1. Crie uma conta em https://resend.com e verifique um domínio (ou use
#    onboarding@resend.dev para testes rápidos, sem verificar domínio).
# 2. Gere a chave em https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM=Foro <onboarding@resend.dev>

# ─── Anthropic (IA interna do CRM) ────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ─── Asaas (pagamentos PIX + cartão) ──────────────────────────────────────────
ASAAS_API_KEY=
ASAAS_BASE_URL=https://www.asaas.com/api/v3
# Sandbox: https://sandbox.asaas.com/api/v3

# ─── NFE.io (emissão automática de NFS-e) ─────────────────────────────────────
NFEIO_API_KEY=
NFEIO_COMPANY_ID=
NFEIO_BASE_URL=https://api.nfe.io/v1

# ─── Consultas pagas (CNPJ / CPF / processual) — carteira de créditos ─────────
# Sem provedor configurado, cada serviço roda em MODO MOCK (sem custo, sem
# chamar nada externo) — útil para testar o fluxo de créditos antes de
# contratar um provedor real. Ver documentation/plataforma-e-precificacao.md
# para comparação de provedores avaliados.
#
# IMPORTANTE: estas chaves são da conta da intellsn (plataforma), NUNCA do
# tenant — o modelo de negócio é centralizar a compra de créditos de API
# numa única conta paga pelo dono da plataforma (ver credits.service.js).
CNPJ_PROVIDER_BASE_URL=
CNPJ_PROVIDER_API_KEY=

CPF_PROVIDER_BASE_URL=
CPF_PROVIDER_API_KEY=

PROCESS_PROVIDER_BASE_URL=
PROCESS_PROVIDER_API_KEY=
