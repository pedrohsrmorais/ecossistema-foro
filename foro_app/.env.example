# Variáveis lidas pelo docker-compose.yml (copie para .env). Tudo tem padrão
# para desenvolvimento — só ANTHROPIC_API_KEY é necessária para o chat de IA.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
JWT_SECRET=troque-por-um-segredo-longo-em-producao
DB_PASSWORD=foro_secret
DB_ROOT_PASSWORD=root_secret
FRONTEND_URL=http://localhost:3040
FEATURE_LOOKUPS_ENABLED=false
# RESEND_API_KEY=   # e-mails de verificação (sem isso o código só aparece no log do container)
# ASAAS_API_KEY=    # cobrança (pagamentos/assinatura) — será trocado/complementado pela Stripe
