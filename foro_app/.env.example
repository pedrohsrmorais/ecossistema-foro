# Variáveis lidas pelo docker-compose.yml  →  cp .env.example .env  e preencha.
# Os marcados OBRIGATÓRIO não têm padrão: o compose se recusa a subir sem eles.

# ── OBRIGATÓRIO ─────────────────────────────────────────────────────────────
# Gere cada segredo com:  openssl rand -hex 32
JWT_SECRET=
DB_PASSWORD=
DB_ROOT_PASSWORD=
# URL pública do app (usada nos links dos e-mails e no CORS), sem barra no final.
FRONTEND_URL=https://app.seudominio.com.br

# ── E-mail (OBRIGATÓRIO em produção: sem isso ninguém confirma a conta) ─────
# Verifique seu domínio no Resend; com onboarding@resend.dev só chega e-mail para o dono da conta.
RESEND_API_KEY=
EMAIL_FROM=Foro <nao-responda@seudominio.com.br>

# ── Suporte e alertas de prazo ──────────────────────────────────────────────
# Caixa que recebe os chamados da página Suporte (o cliente é colocado em Reply-To). Sem isso o chamado só fica no banco.
SUPPORT_EMAIL=suporte@seudominio.com.br
# Opcional: só dígitos com DDI (ex.: 5551999999999) — mostra o botão de WhatsApp na página Suporte.
SUPPORT_WHATSAPP=
# Opcional: texto do horário de atendimento.
SUPPORT_HOURS=
# Resumo diário de prazos por e-mail: a partir de que hora (Brasília) enviar, e liga/desliga (on|off).
DIGEST_HOUR=7
DEADLINE_DIGEST=on

# ── IA ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Modelos de documentos do escritório (opcional). Pasta no SERVIDOR montada em /app/modelos (somente leitura).
# Estrutura: <area>/<chave>.md — sobrepõe o modelo embutido de mesma chave. Ver documentation/documentos-e-modelos.md
MODELOS_DIR=./modelos

# ── Stripe (cobrança por cartão) ────────────────────────────────────────────
# sk_test_... (sandbox) ou sk_live_... (produção) · whsec_... do destino de webhook (veja documentation/pagamentos.md)
# Webhook: https://SEU_DOMINIO/api/webhooks/stripe — eventos: checkout.session.completed, invoice.paid,
# invoice.payment_failed, customer.subscription.updated, customer.subscription.deleted
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Opcionais ───────────────────────────────────────────────────────────────
# NODE_ENV=production             # use "development" só no seu computador
# APP_PORT=3040                   # porta local (127.0.0.1) para o nginx apontar
# CORS_ORIGIN=                    # padrão = FRONTEND_URL
FEATURE_LOOKUPS_ENABLED=false
