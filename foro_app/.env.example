# Variáveis lidas pelo docker-compose.yml  →  cp .env.example .env  e preencha.
# Os marcados OBRIGATÓRIO não têm padrão: o compose se recusa a subir sem eles.

# ── OBRIGATÓRIO ─────────────────────────────────────────────────────────────
# Gere cada segredo com:  openssl rand -hex 32
JWT_SECRET=
DB_PASSWORD=
DB_ROOT_PASSWORD=
# URL pública do app (usada nos links dos e-mails e no CORS), sem barra no final.
FRONTEND_URL=https://app.seudominio.com.br

# ── E-mail (OBRIGATÓRIO em produção: sem isso ninguém confirma a conta) ─────
# Verifique seu domínio no Resend; com onboarding@resend.dev só chega e-mail para o dono da conta.
RESEND_API_KEY=
EMAIL_FROM=Foro <nao-responda@seudominio.com.br>

# ── Suporte e alertas de prazo ──────────────────────────────────────────────
# Caixa que recebe os chamados da página Suporte (o cliente é colocado em Reply-To). Sem isso o chamado só fica no banco.
SUPPORT_EMAIL=suporte@seudominio.com.br
# Opcional: só dígitos com DDI (ex.: 5551999999999) — mostra o botão de WhatsApp na página Suporte.
SUPPORT_WHATSAPP=
# Opcional: texto do horário de atendimento.
SUPPORT_HOURS=
# Resumo diário de prazos por e-mail: a partir de que hora (Brasília) enviar, e liga/desliga (on|off).
DIGEST_HOUR=7
DEADLINE_DIGEST=on

# ── IA ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── Armazenamento de arquivos (S3) — hoje sem uso na interface (processos salvos/PDF desativados no front), mas pronto ───
# FASE DE TESTE: MinIO sobe junto no docker compose; os valores abaixo já funcionam como estão.
# Quando for para valer, troque estas chaves por outras fortes (openssl rand -hex 16) — e apague o volume do MinIO.
# Imagem do MinIO (a MinIO parou de publicar imagens novas em out/2025: depois do 1º `up` que funcionar, fixe a tag exata aqui).
# MINIO_IMAGE=minio/minio:latest
MINIO_ROOT_USER=foro_minio
MINIO_ROOT_PASSWORD=foro_minio_senha_dev
# Console web do MinIO: só em 127.0.0.1 (acesse por túnel:  ssh -L 9001:127.0.0.1:9001 usuario@servidor).
# MINIO_CONSOLE_PORT=9001
# A API usa as mesmas credenciais do MinIO por padrão. Bucket é criado sozinho no boot.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=foro-arquivos
S3_ACCESS_KEY=foro_minio
S3_SECRET_KEY=foro_minio_senha_dev
S3_FORCE_PATH_STYLE=true
# MIGRAR PARA AWS S3: S3_ENDPOINT= (vazio) · S3_FORCE_PATH_STYLE=false · S3_REGION=sa-east-1 · S3_BUCKET=<seu bucket>
#   · S3_ACCESS_KEY/S3_SECRET_KEY = chaves de um usuário IAM com acesso só a esse bucket. Remova o serviço minio do compose.

# ── Pesquisa de processos (Monitoramento Processual → Pesquisar) ────────────
# cnj  = consulta de verdade: DataJud (CNJ, capa + movimentações) e DJEN (publicações/partes), grátis. Ver documentation/consulta-processual.md
# mock = processos fictícios + um PDF de teste (só para desenvolvimento/demonstração)
PROCESS_SEARCH_PROVIDER=cnj
# Chave PÚBLICA do DataJud (a mesma para todos; o CNJ a publica e às vezes troca). Copie a vigente da página
# "API Pública" na wiki do DataJud (datajud-wiki.cnj.jus.br). Formato esperado: o valor da chave, sem o prefixo "APIKey ".
DATAJUD_API_KEY=
# DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br
# DJEN_BASE_URL=https://comunicaapi.pje.jus.br      # o DJEN só aceita servidores com IP do Brasil
# DATAJUD_TIMEOUT_MS=30000
# DJEN_TIMEOUT_MS=20000
# Tamanho máximo do PDF anexado a um processo salvo (MB)
# MAX_PDF_MB=25
# Importação de listas no CRM (CSV/Excel): tamanho máximo do arquivo (MB) e de linhas por importação
# MAX_IMPORT_MB=5
# MAX_IMPORT_ROWS=5000

# Modelos de documentos do escritório (opcional). Pasta no SERVIDOR montada em /app/modelos (somente leitura).
# Estrutura: <area>/<chave>.md — sobrepõe o modelo embutido de mesma chave. Ver documentation/documentos-e-modelos.md
MODELOS_DIR=./modelos

# ── Stripe (cobrança por cartão) ────────────────────────────────────────────
# sk_test_... (sandbox) ou sk_live_... (produção) · whsec_... do destino de webhook (veja documentation/pagamentos.md)
# Webhook: https://SEU_DOMINIO/api/webhooks/stripe — eventos: checkout.session.completed, invoice.paid,
# invoice.payment_failed, customer.subscription.updated, customer.subscription.deleted
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Opcionais ───────────────────────────────────────────────────────────────
# NODE_ENV=production             # use "development" só no seu computador
# APP_PORT=3040                   # porta local (127.0.0.1) para o nginx apontar
# CORS_ORIGIN=                    # padrão = FRONTEND_URL
FEATURE_LOOKUPS_ENABLED=false

# ── Google Agenda (botão "Conectar Google" em Configurações → Integrações) ──────────
# Escopos pedidos: openid, email, profile e calendar.events (nada de Gmail). Ver documentation/google-agenda.md
# Credenciais: salve o JSON baixado do Google Cloud em backend/configs/google_cliente.json ANTES do `docker compose up --build`
# (o arquivo é ignorado pelo git). Só defina as variáveis abaixo se NÃO usar o arquivo:
# GOOGLE_CLIENT_FILE=google_cliente.json
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Padrão = FRONTEND_URL + /api/integrations/google/callback (precisa estar nas "URIs de redirecionamento" do client):
# GOOGLE_REDIRECT_URI=https://app.foro-os.com.br/api/integrations/google/callback
# Chave que cifra os tokens do Google no banco (AES-256-GCM). Gere com:  openssl rand -hex 32
# Se ficar vazia, deriva do JWT_SECRET. ATENÇÃO: trocar depois invalida as conexões (usuários precisam reconectar).
# GOOGLE_TOKEN_ENCRYPTION_KEY=
# Sincronização automática a cada 15 min (on|off). "Sincronizar agora" continua funcionando com off.
# GOOGLE_SYNC=on
