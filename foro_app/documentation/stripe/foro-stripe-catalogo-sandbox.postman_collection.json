              "const j = pm.response.json();",
              "pm.test('3 preços Foro encontrados', function () { pm.expect(j.data.length).to.eql(3); });",
              "console.table(j.data.map(p => ({ id: p.id, lookup_key: p.lookup_key, unit_amount: p.unit_amount, plan: p.metadata.plan_code })));"
