{
  "info": {
    "_postman_id": "f622bcc5-4711-47ae-bc06-ca0b4c57f2cd",
    "name": "Foro - Catalogo v1 - SOMENTE SANDBOX",
    "description": "Cadastro dos planos do Foro no Stripe (sandbox): 1 produto + 3 preços mensais em BRL (Starter R$ 129,90 / Pro R$ 199,90 / Business R$ 399,90).\n\nOrdem: Criar produto (uma vez) → 00 Consultar → 01 Listar → 02/03/04 Criar preços → 05 Verificar.\nO teste grátis de 14 dias é controlado pelo app (sem cartão); o Stripe só cobra a partir da assinatura.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Trava de segurança: este catálogo é SOMENTE SANDBOX. Chaves de produção (sk_live_/rk_live_) abortam a requisição.",
          "const key = pm.environment.get('stripe_secret_key') || '';",
          "if (!key) { throw new Error('Preencha stripe_secret_key (sk_test_...) no environment, apenas localmente.'); }",
          "if (/_live_/.test(key)) { throw new Error('BLOQUEADO: chave LIVE detectada. Este catálogo é só para sandbox (sk_test_...).'); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Criar produto Foro (executar UMA vez; depois ignore)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Produto criado', function () { pm.response.to.have.status(200); });",
              "const j = pm.response.json();",
              "pm.environment.set('stripe_product_id', j.id);",
              "console.log('stripe_product_id =', j.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{stripe_secret_key}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded",
            "type": "text"
          },
          {
            "key": "Stripe-Version",
            "value": "{{stripe_api_version}}",
            "type": "text",
            "description": "Fixa a versão da API para o catálogo ser reproduzível"
          },
          {
            "key": "Idempotency-Key",
            "value": "foro-product-v1",
            "type": "text"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "name",
              "value": "Foro — CRM jurídico com IA",
              "type": "text"
            },
            {
              "key": "description",
              "value": "Assinatura mensal do Foro: CRM para escritórios de advocacia com assistente de IA, processos, prazos e agenda. Recursos de uso renovam semanalmente.",
              "type": "text"
            },
            {
              "key": "metadata[catalog_version]",
              "value": "1",
              "type": "text"
            },
            {
              "key": "metadata[app]",
              "value": "foro",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{stripe_base_url}}/v1/products",
          "host": [
            "{{stripe_base_url}}"
          ],
          "path": [
            "v1",
            "products"
          ]
        },
        "description": "Cria o produto único 'Foro' e grava o id em {{stripe_product_id}}. Os três planos são PREÇOS deste produto."
      }
    },
    {
      "name": "00 - Consultar produto (executar primeiro)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Produto existe', function () { pm.response.to.have.status(200); });",
              "const j = pm.response.json(); console.log(j.id, j.name, 'active=' + j.active);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{stripe_secret_key}}",
            "type": "text"
          },
          {
            "key": "Stripe-Version",
            "value": "{{stripe_api_version}}",
            "type": "text",
            "description": "Fixa a versão da API para o catálogo ser reproduzível"
          }
        ],
        "url": {
          "raw": "{{stripe_base_url}}/v1/products/{{stripe_product_id}}",
          "host": [
            "{{stripe_base_url}}"
          ],
          "path": [
            "v1",
            "products",
            "{{stripe_product_id}}"
          ]
        },
        "description": "Se retornar 404, rode antes a requisição 'Criar produto Foro' (uma única vez)."
      }
    },
    {
      "name": "01 - Listar precos do produto (inspecionar antes de criar)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j = pm.response.json();",
              "console.table((j.data||[]).map(p => ({ id: p.id, nickname: p.nickname, lookup_key: p.lookup_key, unit_amount: p.unit_amount, active: p.active })));",
              "pm.test('Listagem OK', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{stripe_secret_key}}",
            "type": "text"
          },
          {
            "key": "Stripe-Version",
            "value": "{{stripe_api_version}}",
            "type": "text",
            "description": "Fixa a versão da API para o catálogo ser reproduzível"
          }
        ],
        "url": {
          "raw": "{{stripe_base_url}}/v1/prices?product={{stripe_product_id}}&limit=100",
          "host": [
            "{{stripe_base_url}}"
          ],
          "path": [
            "v1",
            "prices"
          ],
          "query": [
            {
              "key": "product",
              "value": "{{stripe_product_id}}"
            },
            {
              "key": "limit",
              "value": "100"
            }
          ]
        },
        "description": "Confira se já existe preço com os lookup_keys foro_*_monthly_brl_v1 antes de criar."
      }
    },
